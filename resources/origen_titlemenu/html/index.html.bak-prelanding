                        </div>
                        <div class="slot-info">
                            <div class="slot-name" translate="locked">SLOT LOCKED</div>
                            <div class="slot-number">SLOT 4</div>
                        </div>
                    </div>
                    <div class="slot" slot="5">
                        <div class="img-container">
                            <div class="img-slot"></div>
                        </div>
                        <div class="slot-info">
                            <div class="slot-name" translate="locked">SLOT LOCKED</div>
                            <div class="slot-number">SLOT 5</div>
                        </div>
                    </div>
                </div>
                <div class="select-button">
                    <div class='container-select' translate="choose_slot">
                        CHOOSE ONE SLOT</div>
                </div>
            </div>
        </div>
        <div class="register">
            <div class="back-button animate__animated animate__fadeInDown animate__faster">
                <i class="fa-solid fa-chevron-left"></i>
                <div translate="back">BACK</div>
            </div>
            <div class="d-flex w-100 h-100">
                <div class="register-form-container slots-content">
                    <div class="title register-title">Crea tu personaje</div>
                    <div class="separator register-sep"></div>
                    <div class="register-inputs">
                        <div class="register-data">
                            <div class="title" translate="name">Name</div>
                            <input type="text" class="name input-register" validation="validation-name" maxlength="15"
                                placeholder="Insert your name" translate="name_des">
                        </div>
                        <div class="register-data">
                            <div class="title" translate="last_name">Last Name</div>
                            <input type="text" class="surname input-register" validation="validation-surname"
                                maxlength="20" placeholder="Insert your lastname" translate="last_name_desc">
                        </div>
                        <div class="register-data">
                            <div class="title" translate="birthday">Birthday</div>
                            <input type="text" id="calendar" class="date input-register" validation="validation-date"
                                placeholder="DD/MM/AAAA" translate="birthday_input" />
                        </div>
                        <div class="register-data">
                            <div class="title" translate="country">Country</div>
                            <input type="text" class="input-register" id="country">
                        </div>
                    </div>
                    <div class="genero-container">
                        <div class="genero" genero="0"><i class="fa-solid fa-mars"></i>
                            <div translate="male">Male</div>
                        </div>
                        <div class="genero" genero="1"><i class="fa-solid fa-venus"></i>
                            <div translate="female">Female</div>
                        </div>
                    </div>
                    <div class="center-container">
                        <div class="btn-register btn-anim disabled">
                            <div class="btn-bg"></div>
                            <div translate="all_ready">¡ALL READY!</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="spawn-selector">
            <div class="back-button spawn-selection animate__animated animate__fadeInDown animate__faster">
                <i class="fa-solid fa-chevron-left"></i>
                <div translate="back">BACK</div>
            </div>
            <div class="d-flex align-items-center justify-content-center w-100 h-100 spawn-layout">
                <div class="container-spawn">
                    <div class="map-container">
                        <div id="mapCentral" class="map"></div>

                    </div>
                    <div class="right-spawn">
                        <h1 class="animate__animated animate__bounceInDown"><i class="fa-solid fa-bed"></i>
                            <div>ÚLTIMA UBICACIÓN</div>
                        </h1>
                        <div class="spawn-spotlight">
                            <div class="spotlight-server-grid">
                                <div class="spot-chip">
                                    <div class="spot-chip-icon"><i class="fa-solid fa-users"></i></div>
                                    <div class="spot-chip-data">
                                        <span>Jugadores</span>
                                        <strong id="spawn-server-online">--/--</strong>
                                    </div>
                                </div>
                                <div class="spot-chip">
                                    <div class="spot-chip-icon"><i class="fa-solid fa-user-shield"></i></div>
                                    <div class="spot-chip-data">
                                        <span>Staff online</span>
                                        <strong id="spawn-server-staff">--</strong>
                                    </div>
                                </div>
                                <div class="spot-chip">
                                    <div class="spot-chip-icon"><i class="fa-solid fa-tower-broadcast"></i></div>
                                    <div class="spot-chip-data">
                                        <span>Latencia</span>
                                        <strong id="spawn-server-latency">-- MS</strong>
                                    </div>
                                </div>
                                <div class="spot-chip">
                                    <div class="spot-chip-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
                                    <div class="spot-chip-data">
                                        <span>Uptime</span>
                                        <strong id="spawn-server-uptime">--</strong>
                                    </div>
                                </div>
                            </div>
                            <div class="spotlight-overview-grid">
                                <div class="overview-card">
                                    <div class="overview-top"><i class="fa-regular fa-clock"></i><span class="overview-label">Hora RP</span></div>
                                    <span class="overview-value" id="overview-rp-time">--:--</span>
                                </div>
                                <div class="overview-card">
                                    <div class="overview-top"><i class="fa-solid fa-cloud-sun"></i><span class="overview-label">Clima actual</span></div>
                                    <span class="overview-value" id="overview-weather">No disponible</span>
                                </div>
                                <div class="overview-card">
                                    <div class="overview-top"><i class="fa-solid fa-wifi"></i><span class="overview-label">Latencia</span></div>
                                    <span class="overview-value" id="overview-latency">-- MS</span>
                                </div>
                                <div class="overview-card">
                                    <div class="overview-top"><i class="fa-solid fa-code-branch"></i><span class="overview-label">Versión</span></div>
                                    <span class="overview-value" id="overview-version">--</span>
                                </div>
                            </div>
                            <div class="spotlight-banner">
                                <i class="fa-solid fa-server"></i>
                                <span id="spawn-server-note">Información en tiempo real del servidor antes de despertar.</span>
                            </div>
                        </div>
                        <div class="btn-aparecer">
                            DESPERTARSE
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="unlock">
        <div class="radial-bg">
            <div class="d-flex h-100 w-100 align-items-center justify-content-center flex-column">
                <div class="title" translate="unlock_slot">¡YOU HAS UNLOCKED AN SLOT!</div>
                <img src="assets/confeti.webp" class="animate__animated animate__bounceIn">
                <div class="continue-button">
                    <div class="btn-anim confirm-slot">
                        <div class="btn-bg"></div>
                        <div translate="continue">Continuar</div>
                    </div>
                </div>
            </div>

        </div>

    </div>
    </div>
    <div class="blackscreen"></div>
    <div class="loading-container">
        <div class="loading-text">
            <div class="loading"><img src="assets/loading.svg"> <span class="text"
                    translate="creating_character">Creating character</span></div>

        </div>
    </div>



    <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
    <script src="build/js/countrySelect.min.js"></script>
    <script src="js/mapLogic.js"></script>
    <script src="js/youtube-player.js"></script>
    <script src="js/app.js"></script>
    <script src="js/bg.js"></script>
    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        $("#country").countrySelect({
            defaultCountry: "us",
            // onlyCountries: ['us', 'gb', 'ch', 'ca', 'do', 'jp'],
            preferredCountries: ['es', 'us', 'gb', 'jp', 'cn']
        });

        $('#calendar').datepicker({
            dateFormat: 'dd/mm/yy',
            dayNames: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
            dayNamesMin: ['Do', 'Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sa'],
            monthNames: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
            monthNamesShort: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic']
        });



    </script>

